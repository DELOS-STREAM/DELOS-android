    </string-array>
    <string name="ps_settings_microphone_title">マイク</string>
    <string name="ps_settings_microphone_description">端末のマイクをボイスチャット用にコンソールへ送ります。初回はマイクへのアクセスを求めます。ミュートはストリームメニューで。</string>
    <string name="ps_settings_visible_loss_title">見えない損失を無視</string>
    <string name="ps_settings_visible_loss_description">自動ビットレートは、誤り訂正で修復できなかった損失のときだけ下がります。Wi-Fi で少しパケットが失われても画質は落ちません。</string>
    <string name="stream_stats_console_bitrate">本体のビットレート</string>
    <string name="stream_stats_console_frames">修復 / 損失フレーム</string>
    <string name="stream_stats_console_keyframes">キーフレーム待ち</string>
    <string name="ps_settings_gyro_aim_title">ジャイロエイム</string>
    <string name="ps_settings_gyro_aim_description">端末を回すと右スティックが動き、どのゲームでもエイムできます。L2 時：L2 を押している間だけ。</string>
    <string name="ps_settings_gyro_aim_off">オフ</string>
    <string name="ps_settings_gyro_aim_l2">L2 時</string>
    <string name="ps_settings_gyro_aim_always">常に</string>
    <string name="ps_settings_gyro_aim_h_title">ジャイロエイム：左右</string>
    <string name="ps_settings_gyro_aim_h_description">本体を左右に向けたときに右スティックが動く量です。ストリームメニューで変更した値は、そのゲームにだけ保存されます。</string>
    <string name="ps_settings_gyro_aim_v_title">ジャイロエイム：上下</string>
    <string name="ps_settings_gyro_aim_v_description">本体を上下に傾けたときに右スティックが動く量です。ストリームメニューで変更した値は、そのゲームにだけ保存されます。</string>
    <string name="stream_help_gyro_aiming_left_and_right">ジャイロエイムの左右の感度です。すぐに反映され、このゲーム用に保存されます。</string>
    <string name="stream_help_gyro_aiming_up_and_down">ジャイロエイムの上下の感度です。すぐに反映され、このゲーム用に保存されます。</string>
