    <string name="ps_settings_keyframe_title">フレーム欠落時にキーフレーム</string>
    <string name="ps_settings_keyframe_description">フレームが欠けるたびに、本体へ完全な新しいフレームを要求します。映像の回復が速くなる代わりに、一時的にデータが増えます。</string>
    <string name="ps_menu_ps_button">PS ボタン</string>
    <string name="ps_menu_create">クリエイト</string>
    <string name="ps_menu_rest">レストモード</string>
    <string name="ps_menu_help_ps_button">本体の PS ボタンを押します：コントロールセンターが開きます。</string>
    <string name="ps_menu_help_create">本体のクリエイトボタンを押します：スクリーンショットとクリップ。</string>
    <string name="ps_menu_help_disconnect">ストリーミングを終了して DELOS に戻ります。ゲームは本体で動き続けます。</string>
    <string name="ps_menu_help_rest">本体をレストモードにしてストリーミングを終了します。ゲームは中断され、本体で再開できます。</string>
    <string name="ps_settings_auto_bitrate_title">自動ビットレート</string>
    <string name="ps_settings_auto_bitrate_description">本体がビットレートを自動で選び、パケットロスがあると下げ、その後また上げます。オフ：下の固定ビットレートを使います。</string>
    <string name="ps_settings_unlock_bitrate_title">ビットレートを200 Mbit/sまで解放</string>
    <string name="ps_settings_unlock_bitrate_description">固定ビットレートを200 Mbit/sまで上げられます。PS5が送るのは最大約50 Mbit/sと報告されているため、それ以上では画質が変わらないことがあります。オフ：固定ビットレートは50 Mbit/s以下のままです。</string>
    <string name="ps_settings_bitrate_zones">緑：この解像度で確実に得られる範囲。オレンジ：この解像度で本体が送ると報告されている最大値まで。赤：それ以上。本体が届けられないことがあります。</string>
    <string name="ps_settings_video_queue_title">フレームキュー</string>
    <string name="ps_settings_video_queue_description">デコーダーを待てるフレームの数。少ないほど遅延が小さく、多いほど不安定なネットワークでも滑らかです。</string>
    <string name="ps_settings_video_queue_few">少ない（最小遅延）</string>
    <string name="ps_settings_video_queue_normal">標準</string>
    <string name="ps_settings_video_queue_many">多い（最も滑らか）</string>
    <string name="ps_settings_audio_buffer_title">オーディオバッファー</string>
    <string name="ps_settings_audio_buffer_description">再生前に DELOS が保持する音声の量。低いほど遅延が小さく、高いほど弱いネットワークでも途切れにくくなります。</string>
    <string name="ps_settings_audio_buffer_low">低（最小遅延）</string>
    <string name="ps_settings_audio_buffer_normal">標準</string>
    <string name="ps_settings_audio_buffer_high">高（途切れにくい）</string>
    <string name="ps_settings_swap_channels_title">左右を入れ替える</string>
    <string name="ps_settings_swap_channels_description">左チャンネルを右から、右チャンネルを左から再生します。</string>
