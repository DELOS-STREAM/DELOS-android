    <string name="ps_search_again">다시 찾기</string>
    <string name="ps_search_meta">로컬 네트워크</string>
    <string name="ps_sign_in_title">한 번만 로그인</string>
    <string name="ps_sign_in_note">Sony 페이지가 DELOS 안에서 열립니다. 비밀번호는 Sony에만 전달되며, DELOS는 본체 연결을 위해 계정 ID만 저장합니다.</string>
    <string name="ps_sign_in_button">PlayStation Network에 로그인</string>
