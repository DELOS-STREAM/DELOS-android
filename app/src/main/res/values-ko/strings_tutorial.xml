<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The intro and the first-run tutorial (issue #129). "DELOS" is never translated or inflected. -->
    <string name="tutorial_welcome">환영해요</string>
    <string name="tutorial_press_a">A를 누르거나</string>
    <string name="tutorial_tap_screen">화면을 터치해 시작하세요</string>

    <string name="tutorial_input_kicker">이제 시작해 볼까요</string>
    <string name="tutorial_input">어떻게 플레이하나요?</string>
    <string name="tutorial_input_note">플레이 방식에 맞는 조작법을 알려 드릴게요. 설정 › 정보에서 언제든 다시 볼 수 있어요.</string>
    <string name="tutorial_controller">컨트롤러</string>
    <string name="tutorial_controller_note">게임패드 또는 휴대용 게임기의 내장 컨트롤러</string>
    <string name="tutorial_controller_connected">연결됨</string>
    <string name="tutorial_touch">터치</string>
    <string name="tutorial_touch_note">화면을 손가락으로 조작해요</string>
    <string name="tutorial_skip_all">튜토리얼 건너뛰기</string>
    <string name="tutorial_skip">건너뛰기</string>
    <string name="tutorial_continue">계속</string>
    <string name="tutorial_success">좋아요!</string>

    <string name="tutorial_chapter_label">챕터 %1$d</string>
    <plurals name="tutorial_chapter_lessons">
        <item quantity="other">짧은 레슨 %d개</item>
    </plurals>
    <string name="tutorial_step">%1$s · %2$d / %3$d</string>
    <string name="tutorial_chapter_navigate">둘러보기</string>
    <string name="tutorial_chapter_navigate_note">라이브러리, 메뉴와 설정을 살펴봐요.</string>
    <string name="tutorial_chapter_play">플레이하기</string>
    <string name="tutorial_chapter_play_note">게임 스트리밍 중 필요한 조작법이에요.</string>
    <string name="tutorial_chapter_ps">PlayStation</string>
    <string name="tutorial_chapter_ps_note">PlayStation에서 스트리밍할 때는 몇 가지 조작이 달라요.</string>

    <string name="tutorial_move_title">이동하기</string>
    <string name="tutorial_move_body">방향 패드나 왼쪽 스틱으로 게임 사이와 모든 메뉴를 이동해요. 강조 표시된 게임이 현재 선택된 게임이에요.</string>
    <string name="tutorial_move_try">오른쪽 누르기</string>
    <string name="tutorial_choose_title">게임 고르기</string>
    <string name="tutorial_choose_body">A를 누르면 강조 표시된 게임을 실행하거나 선택한 버튼, 설정, 메뉴 항목을 열어요.</string>
    <string name="tutorial_choose_try">A 누르기</string>
    <string name="tutorial_back_title">뒤로 가기</string>
    <string name="tutorial_back_body">B는 항상 한 단계 뒤로 돌아가요. 메뉴와 페이지를 닫고, 아직 시작 중인 게임의 실행도 취소해요.</string>
    <string name="tutorial_back_try">B를 눌러 메뉴 닫기</string>
    <string name="tutorial_info_title">게임 정보</string>
    <string name="tutorial_info_body">게임에서 아래를 누르면 플레이 시간, 상세 정보, 스크린샷과 동영상을 볼 수 있어요.</string>
    <string name="tutorial_info_try">아래 누르기</string>
    <string name="tutorial_options_title">옵션</string>
    <string name="tutorial_options_body">오른쪽 메뉴 버튼으로 선택한 게임의 옵션을 열어요. 실행 중인 게임 종료, 아트워크 변경, 개별 설정, 숨기기를 할 수 있어요.</string>
    <string name="tutorial_options_try">오른쪽 메뉴 버튼 누르기</string>
    <string name="tutorial_side_title">사이드 메뉴</string>
    <string name="tutorial_side_body">왼쪽 메뉴 버튼으로 사이드 메뉴를 열어요. DELOS의 외관, 소리와 모든 설정이 있어요.</string>
    <string name="tutorial_side_try">왼쪽 메뉴 버튼 누르기</string>
    <string name="tutorial_switch_title">PC와 PlayStation</string>
    <string name="tutorial_switch_body">시작 화면에서 L1과 R1으로 PC와 PlayStation을 전환해요.</string>
    <string name="tutorial_switch_try">R1 누르기</string>
    <string name="tutorial_stream_title">스트림 메뉴</string>
    <string name="tutorial_stream_body">플레이 중 뒤로나 Guide를 짧게 누르면 스트림 메뉴가 열려요. 키보드, 성능 오버레이, 비트레이트, 업스케일러 등을 사용할 수 있어요. 이 입력은 게임에 전달되지 않아요.</string>
    <string name="tutorial_stream_try">뒤로나 Guide 짧게 누르기</string>
    <string name="tutorial_hold_title">길게 눌러 Guide 보내기</string>
    <string name="tutorial_hold_body">뒤로나 Guide를 0.5초간 누르면 PC에 Guide 버튼을 보내 Steam 오버레이나 Game Bar를 열어요.</string>
    <string name="tutorial_hold_try">뒤로나 Guide 길게 누르기</string>
    <string name="tutorial_guide_sent">PC에 Guide를 보냈어요</string>
    <string name="tutorial_leave_title">연결 끊기와 종료</string>
    <string name="tutorial_leave_body">연결 끊기는 PC의 게임을 계속 실행해 나중에 돌아올 수 있어요. 앱 종료는 확인 없이 PC의 게임을 닫아요.</string>
    <string name="tutorial_leave_try">연결 끊기 선택</string>
    <string name="tutorial_leave_touch_try">연결 끊기 터치</string>
    <string name="tutorial_leave_disconnect">PC에서 게임이 계속 실행돼요</string>
    <string name="tutorial_leave_quit">앱 종료는 PC의 게임을 닫아요</string>
    <string name="tutorial_ps_buttons_title">PlayStation 버튼</string>
    <string name="tutorial_ps_buttons_body">휴대용 게임기에는 터치패드나 만들기 버튼이 없어요. PlayStation 스트림에서는 셀렉트와 뒤로가 대신해요.</string>
    <string name="tutorial_ps_buttons_try">셀렉트 짧게 누르기</string>
    <string name="tutorial_ps_select_tap">셀렉트 짧게 누르기</string>
    <string name="tutorial_ps_select_hold">셀렉트 길게 누르기</string>
    <string name="tutorial_ps_back_hold">뒤로 길게 누르기</string>

    <string name="tutorial_swipe_title">둘러보기</string>
    <string name="tutorial_swipe_body">게임 줄을 스와이프해 게임을 둘러봐요.</string>
    <string name="tutorial_swipe_try">게임 줄 스와이프</string>
    <string name="tutorial_tap_body">한 번 터치하면 게임이 선택되고, 다시 터치하면 실행돼요. 실수로 한 번 터치해도 실행되지 않아요.</string>
    <string name="tutorial_tap_try">선택한 게임 터치</string>
    <string name="tutorial_pull_body">게임을 위로 끌어올리면 플레이 시간, 상세 정보, 스크린샷과 동영상을 볼 수 있어요.</string>
    <string name="tutorial_pull_try">게임을 위로 끌어올리기</string>
    <string name="tutorial_hold_touch_body">게임을 길게 터치하면 옵션이 열려요. 실행 중인 게임 종료, 아트워크 변경, 개별 설정, 숨기기를 할 수 있어요.</string>
    <string name="tutorial_hold_touch_try">게임 길게 터치</string>
    <string name="tutorial_edge_body">화면 왼쪽 가장자리에서 안쪽으로 스와이프하면 사이드 메뉴가 열려요. DELOS의 외관, 소리와 모든 설정이 있어요.</string>
    <string name="tutorial_edge_try">왼쪽 가장자리에서 스와이프</string>
    <string name="tutorial_nav_title">상단 바</string>
    <string name="tutorial_nav_body">상단 버튼으로 설정, 프로필과 PC를 열어요.</string>
    <string name="tutorial_nav_try">버튼 터치</string>
    <string name="tutorial_stream_touch_body">플레이 중 아래쪽 가장자리에서 위로 스와이프하거나 휴대전화의 뒤로 제스처를 사용하면 스트림 메뉴가 열려요.</string>
    <string name="tutorial_stream_touch_try">아래에서 위로 스와이프</string>
    <string name="tutorial_trackpad_title">마우스로 사용하기</string>
    <string name="tutorial_trackpad_body">데스크톱 앱에서는 스트림 메뉴의 터치스크린 모드를 트랙패드로 설정하세요. 노트북처럼 손가락으로 커서를 움직이고, 터치하면 클릭돼요.</string>
    <string name="tutorial_trackpad_try">트랙패드 선택</string>
    <string name="tutorial_osc_title">화면 컨트롤</string>
    <string name="tutorial_osc_body">컨트롤러가 없나요? 스트림 메뉴에서 화면 컨트롤을 켜면 게임 위에 게임패드가 표시돼요. 각 버튼의 위치와 크기도 바꿀 수 있어요.</string>
    <string name="tutorial_osc_try">켜기</string>
    <string name="tutorial_ps_touch_title">터치패드</string>
    <string name="tutorial_ps_touch_body">PlayStation 스트림에서는 화면이 DualSense 터치패드가 돼요. 컨트롤러처럼 스와이프하고 터치하세요.</string>
    <string name="tutorial_ps_touch_try">터치패드 스와이프 또는 터치</string>

    <string name="tutorial_game">내 게임</string>
    <string name="tutorial_starting">시작 중…</string>
    <string name="tutorial_info_played">12시간 플레이 · 마지막 플레이 어제</string>
    <string name="tutorial_info_tag_adventure">어드벤처</string>
    <string name="tutorial_info_tag_media">스크린샷 12장</string>
    <string name="tutorial_menu_status">플레이 준비 완료</string>
    <string name="tutorial_menu_artwork">아트워크</string>
    <string name="tutorial_menu_settings">게임 설정</string>
    <string name="tutorial_menu_hide">숨기기</string>
    <string name="tutorial_side_theme">테마</string>
    <string name="tutorial_side_sounds">소리</string>

    <string name="tutorial_end_kicker">준비됐어요</string>
    <string name="tutorial_end">첫 기기 페어링하기</string>
    <string name="tutorial_end_note">Vibepollo, Apollo 또는 Sunshine을 실행하는 PC나 PlayStation을 연결하세요.</string>
    <string name="tutorial_start">시작하기</string>
    <string name="tutorial_end_replay_kicker">완료</string>
    <string name="tutorial_end_replay">이제 다 배웠어요</string>
    <string name="tutorial_end_replay_note">설정 › 정보에서 언제든 다시 볼 수 있어요.</string>
    <string name="tutorial_windows_back_title">Windows의 뒤로 버튼</string>
    <string name="tutorial_windows_back_body">뒤로 동작을 골라요. 끄면 짧게 눌러 스트림 메뉴, 길게 눌러 Guide를 보내요. 켜면 짧게 눌러 Guide, 길게 눌러 작업 보기를 열어요. 프로필에 저장돼요.</string>
    <string name="tutorial_windows_back_try">설정을 바꾸거나 계속을 선택하세요</string>
    <string name="tutorial_windows_back_continue">계속</string>
    <string name="tutorial_stream_guide_only_body">Guide를 짧게 눌러 스트림 메뉴를 열어요. Windows에서 뒤로는 Game Bar와 작업 보기 전용이에요.</string>
    <string name="tutorial_stream_guide_only_try">Guide 짧게 누르기</string>
    <string name="tutorial_hold_guide_only_body">Guide를 0.5초 길게 눌러 PC에 Guide를 보내요. 뒤로는 Windows 단축키로 사용돼요.</string>
    <string name="tutorial_hold_guide_only_try">Guide 길게 누르기</string>
</resources>
