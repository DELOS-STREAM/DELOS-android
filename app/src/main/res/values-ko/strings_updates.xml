    <string name="update_card_title">Delos %1$s을(를) 사용할 수 있어요</string>
    <string name="update_card_question">지금 업데이트할까요? Delos가 내려받고 확인한 뒤 설치하도록 Android에 넘겨요.</string>
    <string name="update_card_needs_permission">먼저 Android에서 Delos의 업데이트 설치를 허용해야 해요. 설정을 열어 켠 다음 돌아오세요.</string>
    <string name="update_card_downloading">업데이트를 내려받는 중…</string>
    <string name="update_card_installing">Android가 업데이트를 설치하는 중…</string>
    <string name="update_card_percent">%1$d %%</string>
    <string name="update_card_update">업데이트</string>
