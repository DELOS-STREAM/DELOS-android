    <string name="settings_native_update_result_available">新版本 %1$s</string>
    <string name="settings_native_update_result_no_download">版本 %1$s 没有适用于这台设备的下载</string>
    <string name="settings_native_update_result_network">无法连接 GitHub</string>
    <string name="settings_native_update_result_rate_limited">GitHub 繁忙，请稍后再试</string>
    <string name="settings_native_update_result_failed">GitHub 的回复无法使用</string>
    <string name="settings_native_update_result_disabled">已关闭</string>
    <string name="settings_native_update_result_debug">调试版本中不可用</string>
    <string name="help_about_update_check">Delos 每天启动时向 api.github.com 询问一次最新版本。GitHub 能看到这台设备的 IP 地址，不会发送其他任何内容。如有更新版本，开始屏幕会连同发布说明一起提示。只有当你点按“更新”后，Delos 才会从 GitHub 下载，并按随版本公布的列表校验其 SHA-256；之后 Android 会在安装前征求你的同意，并拒绝用其他密钥签名的更新。关闭：完全不发出请求。尚未在设备上测试。</string>
    <string name="help_about_update_now">即使不到一天前刚询问过，也立即询问 GitHub。更新的版本会在开始屏幕上提示。需要先开启“检查更新”。</string>
</resources>
