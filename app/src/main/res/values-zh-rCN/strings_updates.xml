    <string name="settings_native_section_updates">更新</string>
    <string name="settings_native_update_check_title">检查更新</string>
    <string name="settings_native_update_check_description">每天向 api.github.com 询问一次 Delos 的最新版本，并在这里提示。GitHub 能看到这台设备的 IP 地址，不会发送其他任何内容。关闭：完全不发出请求。</string>
    <string name="settings_native_update_now_title">立即检查</string>
    <string name="settings_native_update_now_description">立即询问 GitHub。新版本会在开始屏幕上提示。</string>
    <string name="settings_native_update_now_value">检查</string>
