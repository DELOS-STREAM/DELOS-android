<resources>
    <string name="title_frame_generation">DELOS Tide</string>
    <string name="subtitle_frame_generation">帧生成</string>
    <string name="summary_frame_generation">测试版功能。DELOS Tide 是 DELOS 为串流视频提供的帧生成：GPU 估计串流各帧之间的运动，DELOS 在它们之间显示预测的帧，使运动看起来更流畅。最适合 60 fps 的游戏（60 → 120）；30 fps 的游戏会有伪影。需要支持运动估计或帧外推的 Adreno GPU 驱动。</string>
    <string name="frame_generation_off">关闭</string>
    <string name="frame_generation_2x">2×</string>
    <string name="frame_generation_3x">3×</string>
    <string name="frame_generation_4x">4×</string>
    <string name="help_list_frame_generation">DELOS Tide 是 DELOS 内置的串流视频帧生成。GPU 估算串流中两帧之间的运动并预测中间帧，因此运动更流畅，且不增加延迟。最适合 60 fps 的游戏；30 fps 时快速运动会有伪影。需要支持运动估算的 Adreno GPU。</string>
    <string name="help_list_frame_generation_1">只显示串流本身的帧。</string>
    <string name="help_list_frame_generation_2">每个游戏帧一个预测帧：60 → 120 fps。</string>
    <string name="help_list_frame_generation_3">每个游戏帧两个预测帧：30 → 90 fps。</string>
    <string name="help_list_frame_generation_4">每个游戏帧三个预测帧：30 → 120 fps。</string>
    <!-- The badge under the name of a beta feature (DELOS Tide, the upscaler) -->
    <string name="setting_badge_beta">测试版</string>
</resources>
