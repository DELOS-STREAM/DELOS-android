<resources>
    <string name="title_frame_generation">帧生成</string>
    <string name="summary_frame_generation">实验性功能。在游戏的帧之间显示由 GPU 预测的帧。最适合 60 fps 的游戏（60 → 120）；30 fps 的游戏会有伪影。需要支持帧外推的 GPU 驱动（Adreno）。</string>
    <string name="frame_generation_off">关闭</string>
    <string name="frame_generation_2x">2×</string>
    <string name="frame_generation_3x">3×</string>
    <string name="frame_generation_4x">4×</string>
    <string name="help_list_frame_generation">最适合 60 fps 的游戏；30 fps 时会有伪影。</string>
    <string name="help_list_frame_generation_1">只显示串流本身的帧。</string>
    <string name="help_list_frame_generation_2">每个游戏帧一个预测帧：60 → 120 fps。</string>
    <string name="help_list_frame_generation_3">每个游戏帧两个预测帧：30 → 90 fps。</string>
    <string name="help_list_frame_generation_4">每个游戏帧三个预测帧：30 → 120 fps。</string>
    <!-- The badge under the name of an experimental setting -->
    <string name="setting_badge_experimental">实验性</string>
</resources>
