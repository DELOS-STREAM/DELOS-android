    <string name="ps_settings_keyframe_title">Keyframe after a lost frame</string>
    <string name="ps_settings_keyframe_description">Asks the console for a complete new frame whenever a frame is lost. The picture recovers faster, at the cost of a short burst of data.</string>
    <string name="ps_settings_video_queue_title">Video frame queue</string>
    <string name="ps_settings_video_queue_description">How many frames may wait for the decoder. Fewer means lower latency; more smooths out an uneven network.</string>
