<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Streaming time line under a game's title: the label and its amount (docs/GUI.md, "Streaming time") -->
    <!-- %s: the amount, e.g. "45 minutes" or "20.4 hours" -->
    <string name="playtime_label">Čas streamování: %s</string>
    <plurals name="playtime_minutes">
        <!-- %d: whole minutes, under one hour -->
        <item quantity="one">%d minuta</item>
        <item quantity="few">%d minuty</item>
        <item quantity="many">%d minuty</item>
        <item quantity="other">%d minut</item>
    </plurals>
    <plurals name="playtime_hours">
        <!-- %d: whole hours (no decimal part) -->
        <item quantity="one">%d hodina</item>
        <item quantity="few">%d hodiny</item>
        <item quantity="many">%d hodiny</item>
        <item quantity="other">%d hodin</item>
    </plurals>
    <!-- %s: hours with one decimal in the locale, e.g. 20.4 -->
    <string name="playtime_hours_fraction">%s hodiny</string>
</resources>
