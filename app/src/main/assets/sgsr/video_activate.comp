#version 310 es
// Video adaptation of SGSR 2's Activate stage. With no engine depth buffer, the reactive mask
// rises where the luma is outside the range of the four previous texels the flow points between
// (what the history would bring is not there; within that range bilinear interpolation of fine
// detail and codec noise explain the difference) and where the previous position is outside the
// picture. Forward/backward flow disagreement is rejected in sgsr2_video.frag for both modes.
precision highp float;
precision highp int;
layout(local_size_x=8,local_size_y=8) in;
uniform highp sampler2D currentLuma;
uniform highp sampler2D previousLuma;
uniform highp sampler2D backwardFlow;
uniform ivec2 inputSize;
layout(rgba16f,binding=0) writeonly uniform highp image2D reactiveMask;

vec2 flowUv(vec2 uv) {
    return ((uv*vec2(inputSize)-vec2(0.5))/8.0)/vec2(textureSize(backwardFlow,0));
}

void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,inputSize))) return;
    vec2 uv=(vec2(p)+0.5)/vec2(inputSize);
    vec2 previousUv=uv+textureLod(backwardFlow,flowUv(uv),0.0).xy/vec2(inputSize);
    float current=texelFetch(currentLuma,p,0).r;
    // textureGather reads the base level, whatever the pyramid's filter.
    vec4 around=textureGather(previousLuma,clamp(previousUv,vec2(0.0),vec2(1.0)));
    float outside=max(max(min(min(around.x,around.y),min(around.z,around.w))-current,
                          current-max(max(around.x,around.y),max(around.z,around.w))),0.0);
    float reactive=smoothstep(0.025,0.12,outside);
    if(any(lessThan(previousUv,vec2(0.0)))||any(greaterThan(previousUv,vec2(1.0)))) reactive=1.0;
    imageStore(reactiveMask,p,vec4(reactive));
}
