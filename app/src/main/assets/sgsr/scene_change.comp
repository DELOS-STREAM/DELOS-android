#version 310 es
// Copyright (c) 2026 Delos contributors. GPL-3.0-or-later.
// Conservative whole-frame cut detection: the mean luma of 8 x 8 blocks of the two pictures (16
// samples of the pyramid's coarsest level each, so motion within a block hardly changes it), 1 when
// the blocks' mean difference is above 0.08. False positives merely reset temporal history; a cut
// it misses is still rejected per pixel.
precision highp float;
layout(local_size_x=8,local_size_y=8) in;
layout(rgba16f,binding=0) writeonly uniform highp image2D result;
// Both are the luma pyramid; their minification filter must select a mip level
// (GL_LINEAR_MIPMAP_NEAREST), or textureLod reads level 0.
uniform highp sampler2D currentLuma;
uniform highp sampler2D previousLuma;
// The pyramid's coarsest level (SgsrTemporal.LEVELS - 1).
const float COARSEST=3.0;
shared float differences[64];
void main() {
    uint index=gl_LocalInvocationIndex;
    float current=0.0,previous=0.0;
    for(int i=0;i<16;i++) {
        vec2 uv=(vec2(gl_LocalInvocationID.xy)+(vec2(i&3,i>>2)+0.5)/4.0)/8.0;
        current+=textureLod(currentLuma,uv,COARSEST).r;
        previous+=textureLod(previousLuma,uv,COARSEST).r;
    }
    differences[index]=abs(current-previous)/16.0;
    barrier();
    if(index==0u) {
        float sum=0.0;for(int i=0;i<64;i++) sum+=differences[i];
        imageStore(result,ivec2(0),vec4(sum/64.0>0.08?1.0:0.0,0,0,1));
    }
}
