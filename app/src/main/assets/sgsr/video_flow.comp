// Pyramidal Lucas-Kanade backward flow on an 8-pixel grid, in the inverse compositional form: the
// current picture's gradients and their matrix once per cell, then only the previous picture per
// iteration. Direction: current -> previous. RG = where the cell's centre was in the previous
// picture, relative to now, in pixels of this level. No trust value is written: how far the motion
// can be trusted is decided per pixel from the forward/backward disagreement (sgsr2_video.frag),
// so flat areas and straight edges, where every position along them holds the same picture, keep
// their history.
// Original implementation for decoded video; no engine data or future frames required.
precision highp float;
precision highp int;
layout(local_size_x=8,local_size_y=8) in;
layout(rgba16f,binding=0) writeonly uniform highp image2D flowOutput;
// Both are the luma pyramid; their minification filter must select a mip level
// (GL_LINEAR_MIPMAP_NEAREST), or textureLod reads level 0 at every level.
uniform highp sampler2D currentLuma;
uniform highp sampler2D previousLuma;
uniform highp sampler2D coarseFlow;
uniform int level;
uniform int coarsest;
uniform ivec2 levelSize;
// The previous picture at `position` (pixels of this level), bilinear within this level.
float previous(vec2 position) {
    return textureLod(previousLuma,(position+0.5)/vec2(levelSize),float(level)).r;
}
ivec2 samplePosition(ivec2 center,int i) {
    return clamp(center+ivec2((i&3)*2-3,(i>>2)*2-3),ivec2(0),levelSize-1);
}
// The summed absolute luma difference of the cell's 16 samples, `center` moved by `motion`.
float cost(ivec2 center,vec2 motion) {
    float sum=0.0;
    for(int i=0;i<16;i++) {
        ivec2 p=samplePosition(center,i);
        sum+=abs(texelFetch(currentLuma,p,level).r-previous(vec2(p)+motion));
    }
    return sum;
}
void main() {
    ivec2 cell=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(cell,imageSize(flowOutput)))) return;
    ivec2 center=min(cell*8+ivec2(4),levelSize-1);
    vec2 motion=vec2(0.0);
    if(coarsest==0) {
        // Grid centers are at 4,12,..., rather than at uniformly stretched image boundaries.
        vec2 parentPixel=(vec2(center)+0.5)*0.5-0.5;
        vec2 gridUv=(parentPixel/8.0)/vec2(textureSize(coarseFlow,0));
        motion=textureLod(coarseFlow,gridUv,0.0).xy*2.0;
        // A coarse level that fine detail aliased in must not push this one into a wrong match:
        // start from zero motion where that matches the cell better.
        if(cost(center,vec2(0.0))<cost(center,motion)) motion=vec2(0.0);
    }
    ivec2 last=levelSize-1;
    float values[16];
    vec2 gradients[16];
    vec3 matrix=vec3(0.0);
    for(int i=0;i<16;i++) {
        ivec2 p=samplePosition(center,i);
        values[i]=texelFetch(currentLuma,p,level).r;
        vec2 gradient=0.5*vec2(
            texelFetch(currentLuma,clamp(p+ivec2(1,0),ivec2(0),last),level).r-
                texelFetch(currentLuma,clamp(p-ivec2(1,0),ivec2(0),last),level).r,
            texelFetch(currentLuma,clamp(p+ivec2(0,1),ivec2(0),last),level).r-
                texelFetch(currentLuma,clamp(p-ivec2(0,1),ivec2(0),last),level).r);
        gradients[i]=gradient;
        matrix+=vec3(gradient.x*gradient.x,gradient.x*gradient.y,gradient.y*gradient.y);
    }
    float determinant=matrix.x*matrix.z-matrix.y*matrix.y;
    if(determinant>=1e-8) {
        for(int iteration=0;iteration<6;iteration++) {
            vec2 rhs=vec2(0.0);
            for(int i=0;i<16;i++) {
                rhs+=gradients[i]*(previous(vec2(samplePosition(center,i))+motion)-values[i]);
            }
            vec2 delta=vec2(matrix.z*rhs.x-matrix.y*rhs.y,matrix.x*rhs.y-matrix.y*rhs.x)/determinant;
            motion-=delta/max(1.0,length(delta)/2.0);
            if(dot(delta,delta)<0.0001) break;
        }
    }
    imageStore(flowOutput,cell,vec4(motion,0.0,0.0));
}
